{
  "name": "@repo/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "db:migrate": "node --env-file-if-exists=../../.env src/cli/migrate.ts",
    "db:revert": "node --env-file-if-exists=../../.env src/cli/revert.ts",
    "db:seed": "node --env-file-if-exists=../../.env src/cli/seed.ts",
    "db:test-schemas": "node src/cli/list-test-schemas.ts"
  },
  "dependencies": {
    "@repo/contracts": "workspace:*",
    "pg": "8.23.0",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
