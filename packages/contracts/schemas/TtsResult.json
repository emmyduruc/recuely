{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TtsResult.json",
  "title": "TtsResult",
  "type": "object",
  "description": "Synthesized audio for one chunk. `timings` is null exactly when `timingSource` is `none`.",
  "properties": {
    "audioUrl": {
      "type": "string",
      "minLength": 1,
      "description": "Where to fetch the audio."
    },
    "durationMs": {
      "type": "number",
      "minimum": 0,
      "description": "Audio duration in ms."
    },
    "timings": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "WordTiming.json"
      },
      "description": "Word timings or null."
    },
    "timingSource": {
      "type": "string",
      "enum": [
        "provider",
        "boundary-event",
        "none"
      ],
      "description": "Origin of the timings."
    },
    "cacheKey": {
      "type": "string",
      "minLength": 1,
      "description": "Key of the cached audio."
    }
  },
  "required": [
    "audioUrl",
    "durationMs",
    "timings",
    "timingSource",
    "cacheKey"
  ],
  "additionalProperties": true
}
