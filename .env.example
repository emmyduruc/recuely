# Copy to .env (repo root, gitignored) and fill in. SPEC.md §B2 and §C1.1.

# App database: your Neon dev branch. Neon console → Connect → "Connection string".
# TLS is required (sslmode=require). The pooled string (host contains "-pooler") is fine for the app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/recuely?sslmode=require

# Integration tests: a SEPARATE Neon branch (e.g. "test") or database. Use the DIRECT connection
# string (no "-pooler"). Each `pnpm test:int` run creates an it_<timestamp>_<random> schema here
# and drops it afterwards; tests refuse to run if this points at the same database as DATABASE_URL.
DATABASE_URL_TEST=postgresql://USER:PASSWORD@ep-YYYY.REGION.aws.neon.tech/recuely?sslmode=require

# Swagger UI (/api/docs) and /api/openapi.json in production builds. Always on in `pnpm dev`.
API_DOCS_ENABLED=false
