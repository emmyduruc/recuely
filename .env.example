# Copy to .env (repo root, gitignored) and fill in. SPEC.md §B2 and §C1.1.
# Every line must be KEY=value. Never paste bare passwords or other values on their own line.

# App database: Neon. Console → your project → Connect → connection string (keep sslmode=require).
# The direct string (no "-pooler" in the host) is best for `pnpm db:migrate`.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require
# Neon uses a publicly trusted certificate: leave empty.
DATABASE_URL_CA_CERT=

# Integration tests only: Supabase. Dashboard → Connect → "Session pooler" (port 5432).
# User looks like postgres.<project-ref>; replace [YOUR-PASSWORD]. Each `pnpm test:int` run creates an
# it_<timestamp>_<random> schema here and drops it afterwards. Tests refuse to run against DATABASE_URL.
DATABASE_URL_TEST=postgresql://postgres.PROJECTREF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres
# Supabase signs TLS with its own CA. Dashboard → Database → SSL → Download certificate,
# save as certs/supabase-ca.crt (gitignored). Path is relative to the repo root.
DATABASE_URL_TEST_CA_CERT=certs/supabase-ca.crt

# Swagger UI (/api/docs) and /api/openapi.json in production builds. Always on in `pnpm dev`.
API_DOCS_ENABLED=false

# Take media (SPEC.md Task 4). Relative to the repo root; `storage/` is gitignored. Media is never deleted by the app.
STORAGE_DIR=storage
# Largest accepted take upload (bytes; default 2 GiB) and free disk space to keep (default 1 GiB).
MAX_UPLOAD_BYTES=2147483648
MIN_FREE_BYTES=1073741824

# Cloud speech (SPEC.md §B12). Server-only; never exposed to the browser. Empty = local fallback only.
# Used only after the user opts in (Settings → cloud speech consent). Restart `pnpm dev` after changing it.
OPENAI_API_KEY=
# Optional overrides (defaults shown): models chosen in Task 10a.
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_STT_MODEL=gpt-transcribe
# Local AI service (Kokoro + faster-whisper, Task 10b); the fallback when offline or without consent.
# AI_SERVICE_URL=http://127.0.0.1:8008

# Dev-only design page /_design (on automatically in `pnpm dev`; SPEC.md Task 11).
NUXT_PUBLIC_DESIGN_PAGE_ENABLED=false
